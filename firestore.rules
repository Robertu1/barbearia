rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isResourceOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isOwnerAccount() {
      // Checa se o documento do usuário logado possui a permissão de dono (owner)
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'phone']) 
        && data.uid == request.auth.uid && data.name is string && data.email is string;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['id', 'userId', 'barberName', 'serviceName', 'price', 'date', 'time', 'status', 'createdAt'])
        && data.userId == request.auth.uid && data.price >= 0;
    }

    match /users/{userId} {
      // Somente o próprio cliente ou um dono podem ler os perfis
      allow get: if isResourceOwner(userId) || isOwnerAccount();
      allow list: if isOwnerAccount();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isResourceOwner(userId) && isValidUser(incoming());
      allow delete: if false; 
    }

    match /appointments/{appointmentId} {
      // Somente o dono do agendamento ou o administrador podem ler e listar
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isOwnerAccount());
      allow list: if isSignedIn() && (isOwnerAccount() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(appointmentId) && isValidAppointment(incoming());
      allow update: if isSignedIn() && isValidId(appointmentId) && incoming().id == existing().id && incoming().userId == existing().userId && (isOwnerAccount() || existing().userId == request.auth.uid);
      allow delete: if false; 
    }

    match /saas_config/{configId} {
      allow read: if isSignedIn();
      // Apenas o dono pode mudar a configuração do SaaS
      allow write: if isOwnerAccount() && isValidId(configId);
    }

    match /saas_feedbacks/{feedbackId} {
      // Apenas o dono pode ler os feedbacks
      allow read: if isOwnerAccount();
      allow create: if isSignedIn() && isValidId(feedbackId);
    }
  }
}
